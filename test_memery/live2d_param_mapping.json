  "actions": {
    "_description": "一次性动作，以身体和头部动作为主，手臂仅极微小自然摆动，播完回到当前表情",

    "nod": {
      "duration": 0.8,
      "sequence": [
        {"time": 0.0, "ParamAngleY": 0.0},
        {"time": 0.2, "ParamAngleY": 8.0},
        {"time": 0.4, "ParamAngleY": -2.0},
        {"time": 0.6, "ParamAngleY": 4.0},
        {"time": 0.8, "ParamAngleY": 0.0}
      ]
    },

    "shake_head": {
