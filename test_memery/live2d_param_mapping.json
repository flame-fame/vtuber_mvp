      "ParamEyeLSmile": 0.0,
      "ParamEyeRSmile": 0.0,
      "ParamEyeLOpen": 0.3,
      "ParamEyeROpen": 0.3,
      "ParamEyeBallX": 0.3,
      "ParamEyeBallY": 0.4,
      "ParamCheek": -0.9,
      "ParamAngleX": 30.0,
      "ParamAngleY": 30.0,
      "ParamBodyAngleX": 10.0
