      "ParamBrowLForm": -0.7,
      "ParamBrowRForm": -0.7,
      "ParamEyeLOpen": 1.2,
      "ParamEyeROpen": 1.2
    },

    "shy": {
      "ParamMouthForm": 0.3,
      "ParamCheek": 0.0,
