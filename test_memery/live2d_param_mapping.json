{
  "_description": "Live2D VTubeStudio 表情动作参数映射表（v2，适配身体位置参数，限制手臂动作）",
  "_parameter_ranges": {
    "身体位置 (平移)": "ParamFacePositionX/Y/Z ∈ [-5, 5]",
    "头部角度": "ParamAngleX/Y/Z ∈ [-30, 30]",
    "脸颊": "ParamCheek ∈ [-1, 0]",
    "嘴角": "ParamMouthForm ∈ [-1, 1]",
    "嘴张开": "ParamMouthOpenY ∈ [0, 1]",
    "眼睛开闭": "ParamEyeLOpen/ROpen ∈ [0, 1.2]",
    "眼睛微笑": "ParamEyeLSmile/RSmile ∈ [0, 1]",
    "眼球": "ParamEyeBallX/Y ∈ [-1, 1]",
    "眉毛": "ParamBrowLForm/RForm ∈ [-1, 1]",
    "身体角度": "ParamBodyAngleX/Y/Z ∈ [-10, 10]",
    "手臂 (仅微摆)": "ParamArmLA/RA ∈ [-3, 3] (实际使用时幅度控制在 ±2 以内)"
  },

  "expressions": {
    "_comment": "持续表情状态，仅影响面部参数，不涉及身体运动",

    "neutral": {
      "ParamMouthForm": 0.0,
      "ParamCheek": 0.0,
      "ParamBrowLForm": 0.0,
      "ParamBrowRForm": 0.0,
      "ParamEyeLSmile": 0.0,
      "ParamEyeRSmile": 0.0
    },

    "happy": {
      "ParamMouthForm": 0.5,
      "ParamCheek": -0.5,
      "ParamEyeLSmile": 0.8,
      "ParamEyeRSmile": 0.8,
      "ParamEyeLOpen": 0.3,
      "ParamEyeROpen": 0.3,
      "ParamBrowLForm": 0.5,
      "ParamBrowRForm": 0.5
    },

    "very_happy": {
      "ParamMouthForm": 1.0,
      "ParamCheek": 0.0,
      "ParamEyeLSmile": 1.0,
      "ParamEyeRSmile": 1.0,
      "ParamEyeLOpen": 0.0,
      "ParamEyeROpen": 0.0,
      "ParamBrowLForm": 1.0,
      "ParamBrowRForm": 1.0
    },

    "sad": {
